# Optional Wallhaven API key. Public SFW searches work without it.
# Read by Rust during builds; never use a VITE_ variable for this value.
# A build-time key can be recovered from a distributed executable.
WALLHAVEN_API_KEY=

# Optional shared SoundCloud session for authentication-required fallback.
# Use the oauth_token cookie value of a dedicated account; never a VITE_ key.
# Read at build time into the Rust binary, not a secure secret once shipped.
# Leave empty for guest fallback and user sign-in. Never commit a real value.
TEMPO_SOUNDCLOUD_OAUTH_TOKEN=
